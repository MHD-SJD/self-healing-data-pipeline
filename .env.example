# ==============================================================================
# Self-Healing Data Pipeline Platform - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=self_healing_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/self_healing_platform

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:root@localhost:5432/airflow

# FastAPI Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
SECRET_KEY=dev-secret-key-change-in-production-pipeline-32bytes-min

# Monitoring & Alerting
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
ALERT_WEBHOOK_URL=http://localhost:8000/api/v1/health
ALERT_EMAIL_RECIPIENT=data-platform-alerts@example.com

# Data Storage Directories
DATA_DIR=./data
SAMPLES_DIR=./data/samples
QUARANTINE_DIR=./data/quarantine

